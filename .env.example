
# =========================================================
# DJANGO CORE SETTINGS
# =========================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-strong-random-secret-key-here
DEBUG=False

ALLOWED_HOSTS=localhost,127.0.0.1

# Hidden Django admin URL segment (no leading/trailing slash).
# /admin/ always returns 404; open admin at /<ADMIN_URL_PATH>/
ADMIN_URL_PATH=erp-console-x7k2m9

# =========================================================
# DATABASE SETTINGS
# =========================================================

# sqlite -> local dev | mysql -> production
DB_ENGINE=sqlite

DB_NAME=my_db
DB_USER=my_user
DB_PASSWORD=your-strong-db-password
DB_HOST=localhost
DB_PORT=3306

DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=60

# =========================================================
# EMAIL SETTINGS
# =========================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=your-mail-host.com
EMAIL_PORT=465
EMAIL_USE_SSL=True

EMAIL_HOST_USER=no-reply@your-domain.com
EMAIL_HOST_PASSWORD=your-email-password

DEFAULT_FROM_EMAIL=no-reply@your-domain.com
EMAIL_TIMEOUT=30

# =========================================================
# STATIC & MEDIA SETTINGS
# =========================================================

STATIC_URL=/static/
STATIC_ROOT=staticfiles

MEDIA_URL=/media/
MEDIA_ROOT=media

# =========================================================
# CORS SETTINGS
# =========================================================

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# =========================================================
# CSRF SETTINGS
# =========================================================

# Frontend origins, not just the API hostname. See docs/production-login-cors.md.
CSRF_TRUSTED_ORIGINS=https://your-production-domain.com

# =========================================================
# API SETTINGS
# =========================================================

API_PAGE_SIZE=12
TOKEN_EXPIRY_DAYS=7
TOKEN_LIMIT=5

# =========================================================
# CACHE SETTINGS
# =========================================================

CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake

# =========================================================
# FILE UPLOAD SETTINGS
# =========================================================

MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.mp3,.epub

# =========================================================
# SITE SETTINGS
# =========================================================

SITE_ADDRESS=https://your-production-domain.com

# =========================================================
# MAINTENANCE (logs + auto backups) — Hostinger friendly
# =========================================================

# Activity logs older than this many days are permanently deleted nightly.
ACTIVITY_LOG_RETENTION_DAYS=365

# Automatic backups older than this many days are deleted nightly.
# Manual backups (created from Settings UI) are never auto-deleted.
BACKUP_RETENTION_DAYS=30

# Keep False on production. Accidental restore can wipe newer data.
BACKUP_RESTORE_ENABLED=False

# Optional custom backup folder (absolute path). Empty = <project>/backups
# BACKUP_DIR=

# Optional: enable HTTP cron for Hostinger (no shell needed).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then cron: curl -fsS -X POST "https://YOUR-API/api/maintenance/run/" -H "Authorization: Bearer SECRET"
# Leave empty to disable the HTTP endpoint (use scripts/hostinger_cron.sh instead).
MAINTENANCE_CRON_SECRET=

# =========================================================
# SECURITY SETTINGS (production)
# =========================================================

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
